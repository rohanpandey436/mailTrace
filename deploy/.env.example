# Copy to .env and adjust. All keys are optional.

# Storage: SQLite database, evidence store and cached model live here (default: <project>/data)
# MAILTRACE_DATA_DIR=./data

# Optional PostgreSQL / Supabase backend. Leave empty (the default) to use the
# SQLite file under MAILTRACE_DATA_DIR - that is what the test-suite and the
# Render free tier run on. Setting this also needs the optional driver:
#     pip install -r backend/requirements-pg.txt
# Without the driver, or if the server cannot be reached, MailTrace logs the
# reason and keeps running on SQLite; GET /api/health reports which backend
# actually won ("database": "sqlite" | "postgresql"). Evidence .eml files stay
# on the local filesystem either way. Ignored in zero-persistence mode.
# MAILTRACE_DATABASE_URL=postgresql://user:password@host:5432/mailtrace

# Organisation being protected (used for spoof / lookalike / exec-impersonation checks)
MAILTRACE_ORG_NAME=Acme Corp
MAILTRACE_ORG_DOMAINS=acme-corp.in
MAILTRACE_EXECUTIVES=ceo,cfo,managing director,sarthak srivastava
MAILTRACE_PROTECTED_BRANDS=
MAILTRACE_TRUSTED_RELAYS=

# Live enrichment (DNS, WHOIS, GeoIP, DNSBL, Tor list). Set false for an offline demo.
MAILTRACE_ENABLE_NETWORK=true
MAILTRACE_LOOKUP_TIMEOUT=3
MAILTRACE_MAX_DOMAIN_LOOKUPS=6
MAILTRACE_MAX_GEO_LOOKUPS=8
MAILTRACE_CACHE_TTL_SECONDS=21600
# Optional AbuseIPDB key for IP reputation
MAILTRACE_ABUSEIPDB_KEY=
# Optional URLhaus (abuse.ch) key for malicious-domain lookups. Without a key the
# feed is skipped; abuse.ch has required authentication since 2025.
MAILTRACE_URLHAUS_KEY=
# Optional VirusTotal v3 key. When set, each non-inline attachment's SHA-256 is
# looked up against GET /api/v3/files/{sha256} (max 4 per message, cached), and
# a finding is added when engines flag the file. ONLY the hash is sent - the
# attachment itself is never uploaded, because a victim's invoices and ID scans
# would then be shared with VirusTotal's partners. Empty (the default) means no
# request is made at all and the analysis is unchanged.
MAILTRACE_VIRUSTOTAL_KEY=

# Privacy & alerting
MAILTRACE_PII_MASK_DEFAULT=false
MAILTRACE_ALERT_THRESHOLD=70

# Stage 4 threat score, as stated on the pitch deck:
#   THREAT SCORE = 0.20 Auth + 0.35 Text + 0.25 URL + 0.10 Network + 0.10 Entropy
# Weights are normalised automatically, so they express relative importance and
# need not sum to 1 by hand. The variable name is MAILTRACE_WEIGHT_<TERM>, where
# TERM is one of AUTH, TEXT, URL, NETWORK, ENTROPY. Any other name is ignored.
MAILTRACE_WEIGHT_AUTH=0.20
MAILTRACE_WEIGHT_TEXT=0.35
MAILTRACE_WEIGHT_URL=0.25
MAILTRACE_WEIGHT_NETWORK=0.10
MAILTRACE_WEIGHT_ENTROPY=0.10

# Stage 3A: attachment Shannon entropy above this is treated as packed,
# encrypted or obfuscated (bits per byte, 8.0 is uniformly random).
MAILTRACE_ENTROPY_THRESHOLD=7.0

# Stage 3A: leave empty to use the bundled TF-IDF classifier. Set to a
# DistilRoBERTa sequence-classification model id to use a transformer instead;
# needs the optional packages in requirements-ml.txt and about 2 GB of RAM.
MAILTRACE_TRANSFORMER_MODEL=

# Stage 3B: path to a MaxMind GeoLite2-City .mmdb file. When set it is used in
# preference to the ip-api.com service, which stays as the fallback.
MAILTRACE_MAXMIND_DB=

# Stage 5A: how close two message bodies must be to count as one campaign.
MAILTRACE_SIMHASH_MAX_DISTANCE=12
MAILTRACE_TLSH_MAX_DISTANCE=60

# Stage 5B: comma-separated URLs that receive a JSON POST for every alert
# (SIEM, SOAR, Slack incoming webhook, and so on).
MAILTRACE_WEBHOOK_URLS=

# Stage 5C: analyse and return without writing anything to disk. No database,
# no stored copies of messages. Everything is lost when the process exits.
MAILTRACE_ZERO_PERSISTENCE=false

# Web server
MAILTRACE_HOST=127.0.0.1
MAILTRACE_PORT=8000
MAILTRACE_LOG_LEVEL=info
# Per-file upload limit in bytes (default 15 MiB); larger uploads get HTTP 413
MAILTRACE_MAX_UPLOAD_BYTES=15728640
# Where the SQLite database, evidence store and trained model live.
# LEAVE THIS COMMENTED OUT unless you mean it: an empty value is NOT "use the
# default", it resolves to the directory you happened to launch from, which
# scatters the database and the evidence store wherever you ran the command.
# MAILTRACE_DATA_DIR=./data
